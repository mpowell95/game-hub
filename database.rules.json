{
  "rules": {
    ".read": false,
    ".write": false,

    "messages": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",

      "threads": {
        "$pair": {
          ".read": "auth != null && root.child('msgAuth').child(auth.uid).exists() && $pair.contains(root.child('msgAuth').child(auth.uid).val())",
          ".write": "auth != null && root.child('msgAuth').child(auth.uid).exists() && $pair.contains(root.child('msgAuth').child(auth.uid).val())"
        }
      },

      "index": {
        "$code": {
          ".read": "auth != null && $code === root.child('msgAuth').child(auth.uid).val()",
          "$other": {
            ".write": "auth != null && root.child('msgAuth').child(auth.uid).exists() && ($code === root.child('msgAuth').child(auth.uid).val() || $other === root.child('msgAuth').child(auth.uid).val())"
          }
        }
      }
    },

    "careers": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('msgAuth').child(auth.uid).val() === $code || root.child('admins').child(auth.uid).val() === true)"
      }
    },

    "courseDrafts": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && (root.child('msgAuth').child(auth.uid).val() === $code || root.child('admins').child(auth.uid).val() === true)"
      }
    },

    "msgAuth": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "admins": { ".read": "auth != null", ".write": false },

    "adminConfig":    { ".read": "auth != null", ".write": "auth != null && root.child('admins').child(auth.uid).val() === true" },
    "archive":        { ".read": "auth != null", ".write": "auth != null" },
    "bugReplies":     { ".read": "auth != null", ".write": "auth != null && root.child('admins').child(auth.uid).val() === true" },
    "bugReplyShots":  { ".read": "auth != null", ".write": "auth != null && root.child('admins').child(auth.uid).val() === true" },
    "bugReportShots": { ".read": "auth != null", ".write": "auth != null" },
    "bugReports":     { ".read": "auth != null", ".write": "auth != null", ".indexOn": ["createdAtMs"] },
    "challenge":      { ".read": "auth != null", ".write": "auth != null" },
    "deviceReports":  { ".read": "auth != null", ".write": "auth != null" },
    "flight":         { ".read": "auth != null", ".write": "auth != null" },
    "cuppong": { ".read": "auth != null", ".write": "auth != null",
      "games": { "$id": {
        "created": { ".validate": "newData.val() === data.val() || (newData.isNumber() && newData.val() >= now - 120000 && newData.val() <= now + 120000)" },
        "updated": { ".validate": "newData.val() === data.val() || (newData.isNumber() && newData.val() >= now - 120000 && newData.val() <= now + 120000)" },
        "log": { "$k": { ".validate": "data.exists() || (newData.child('at').isNumber() && newData.child('at').val() >= now - 120000 && newData.child('at').val() <= now + 120000)" } }
      } } },
    "darts": { ".read": "auth != null", ".write": "auth != null",
      "games": { "$id": {
        "created": { ".validate": "newData.val() === data.val() || (newData.isNumber() && newData.val() >= now - 120000 && newData.val() <= now + 120000)" },
        "updated": { ".validate": "newData.val() === data.val() || (newData.isNumber() && newData.val() >= now - 120000 && newData.val() <= now + 120000)" },
        "log": { "$k": { ".validate": "data.exists() || (newData.child('at').isNumber() && newData.child('at').val() >= now - 120000 && newData.child('at').val() <= now + 120000)" } }
      } } },
    "flicksoccer": { ".read": "auth != null", ".write": "auth != null",
      "games": { "$id": {
        "created": { ".validate": "newData.val() === data.val() || (newData.isNumber() && newData.val() >= now - 120000 && newData.val() <= now + 120000)" },
        "updated": { ".validate": "newData.val() === data.val() || (newData.isNumber() && newData.val() >= now - 120000 && newData.val() <= now + 120000)" },
        "log": { "$k": { ".validate": "data.exists() || (newData.child('at').isNumber() && newData.child('at').val() >= now - 120000 && newData.child('at').val() <= now + 120000)" } }
      } } },
    "eightball": { ".read": "auth != null", ".write": "auth != null",
      "games": { "$id": {
        "created": { ".validate": "newData.val() === data.val() || (newData.isNumber() && newData.val() >= now - 120000 && newData.val() <= now + 120000)" },
        "updated": { ".validate": "newData.val() === data.val() || (newData.isNumber() && newData.val() >= now - 120000 && newData.val() <= now + 120000)" },
        "log": { "$k": { ".validate": "data.exists() || (newData.child('at').isNumber() && newData.child('at').val() >= now - 120000 && newData.child('at').val() <= now + 120000)" } }
      } } },
    "archery": { ".read": "auth != null", ".write": "auth != null",
      "games": { "$id": {
        "created": { ".validate": "newData.val() === data.val() || (newData.isNumber() && newData.val() >= now - 120000 && newData.val() <= now + 120000)" },
        "updated": { ".validate": "newData.val() === data.val() || (newData.isNumber() && newData.val() >= now - 120000 && newData.val() <= now + 120000)" },
        "log": { "$k": { ".validate": "data.exists() || (newData.child('at').isNumber() && newData.child('at').val() >= now - 120000 && newData.child('at').val() <= now + 120000)" } }
      } } },
    "chinchon": { ".read": "auth != null", ".write": "auth != null",
      "games": { "$id": {
        "created": { ".validate": "newData.val() === data.val() || (newData.isNumber() && newData.val() >= now - 120000 && newData.val() <= now + 120000)" },
        "updated": { ".validate": "newData.val() === data.val() || (newData.isNumber() && newData.val() >= now - 120000 && newData.val() <= now + 120000)" },
        "log": { "$k": { ".validate": "data.exists() || (newData.child('at').isNumber() && newData.child('at').val() >= now - 120000 && newData.child('at').val() <= now + 120000)" } }
      } } },
    "escoba": { ".read": "auth != null", ".write": "auth != null",
      "games": { "$id": {
        "created": { ".validate": "newData.val() === data.val() || (newData.isNumber() && newData.val() >= now - 120000 && newData.val() <= now + 120000)" },
        "updated": { ".validate": "newData.val() === data.val() || (newData.isNumber() && newData.val() >= now - 120000 && newData.val() <= now + 120000)" },
        "log": { "$k": { ".validate": "data.exists() || (newData.child('at').isNumber() && newData.child('at').val() >= now - 120000 && newData.child('at').val() <= now + 120000)" } }
      } } },
    "battlearena": { ".read": "auth != null", ".write": "auth != null",
      "games": { "$id": {
        "created": { ".validate": "newData.val() === data.val() || (newData.isNumber() && newData.val() >= now - 120000 && newData.val() <= now + 120000)" },
        "updated": { ".validate": "newData.val() === data.val() || (newData.isNumber() && newData.val() >= now - 120000 && newData.val() <= now + 120000)" },
        "log": { "$k": { ".validate": "data.exists() || (newData.child('at').isNumber() && newData.child('at').val() >= now - 120000 && newData.child('at').val() <= now + 120000)" } }
      } } },
    "battleship": { ".read": "auth != null", ".write": "auth != null",
      "games": { "$id": {
        "created": { ".validate": "newData.val() === data.val() || (newData.isNumber() && newData.val() >= now - 120000 && newData.val() <= now + 120000)" },
        "updated": { ".validate": "newData.val() === data.val() || (newData.isNumber() && newData.val() >= now - 120000 && newData.val() <= now + 120000)" },
        "log": { "$k": { ".validate": "data.exists() || (newData.child('at').isNumber() && newData.child('at').val() >= now - 120000 && newData.child('at').val() <= now + 120000)" } }
      } } },
    "hoops": { ".read": "auth != null", ".write": "auth != null",
      "games": { "$id": {
        "created": { ".validate": "newData.val() === data.val() || (newData.isNumber() && newData.val() >= now - 120000 && newData.val() <= now + 120000)" },
        "updated": { ".validate": "newData.val() === data.val() || (newData.isNumber() && newData.val() >= now - 120000 && newData.val() <= now + 120000)" },
        "moves": { "$k": { ".validate": "data.exists() || (newData.child('at').isNumber() && newData.child('at').val() >= now - 120000 && newData.child('at').val() <= now + 120000)" } }
      } } },
    "players":        { ".read": "auth != null", ".write": "auth != null" },
    "directory":      { ".read": "auth != null", ".write": false },
    "boards":         { "v1": { "lb": { ".read": "auth != null" }, "bee": { ".read": "auth != null" }, "beeOwn": { ".read": "auth != null" } }, ".write": false },
    "beeAlerts":      { ".read": "auth != null && root.child('admins').child(auth.uid).val() === true", ".write": false },
    "integrityFlags": { ".read": "auth != null && root.child('admins').child(auth.uid).val() === true", ".write": false },
    "integrityAlerts": { ".read": "auth != null && root.child('admins').child(auth.uid).val() === true", ".write": false },
    "nudges": {
      "$code": {
        "$key": {
          ".read": "auth != null",
          ".write": "auth != null && newData.exists() && newData.child('from').val() === root.child('msgAuth').child(auth.uid).val() && (!data.exists() || now - data.child('t').val() >= 21600000)",
          ".validate": "newData.hasChildren(['from', 't']) && newData.child('t').val() === now && $key.matches(/^(hoops|skeeChallenges|cuppong|darts|flicksoccer|archery|chinchon|escoba|battlearena|battleship)~[A-Za-z0-9_-]+$/) && $key.length <= 60"
        }
      }
    },

    "beeDaily": {
      "$puzzle": {
        ".read": "auth != null",
        "$code": {
          ".write": "auth != null && newData.exists() && $code === root.child('msgAuth').child(auth.uid).val()",
          ".validate": "$puzzle.matches(/^(es-)?[a-z0]-[a-z0]{6}$/) && newData.hasChildren(['name', 'words', 'points', 'rank', 'at']) && (!data.exists() || newData.child('words').val() >= data.child('words').val())",
          "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "emoji": { ".validate": "newData.isString() && newData.val().length <= 16" },
          "words": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500" },
          "points": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000" },
          "rank": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9" },
          "at": { ".validate": "newData.val() === now" },
          "t0": { ".validate": "newData.isNumber()" },
          "tg": { ".validate": "newData.isNumber()" },
          "ts": { ".validate": "newData.isString() && newData.val().length <= 3000" },
          "dw": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500" },
          "dp": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000" },
          "dr": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9" },
          "$other": { ".validate": false }
        }
      }
    },

    "beeFlags": {
      ".read": "auth != null",
      ".write": false
    },

    "playLog": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$code": {
        ".read": "auth != null && $code === root.child('msgAuth').child(auth.uid).val()",
        ".indexOn": ["k"],
        "$k": {
          ".write": "auth != null && newData.exists() && $code === root.child('msgAuth').child(auth.uid).val() && (!data.exists() || data.child('t').val() === newData.child('t').val())",
          ".validate": "$k.matches(/^[0-9]{13}-[0-9]{1,4}$/) && newData.hasChildren(['t', 'g', 's'])",
          "t": { ".validate": "newData.isNumber()" },
          "s": { ".validate": "newData.val() === now" },
          "g": { ".validate": "newData.isString() && newData.val().length <= 24" },
          "f": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "a": { ".validate": "newData.isString() && newData.val().length <= 1600" },
          "e": { ".validate": "newData.isString() && newData.val().length <= 12" },
          "k": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "w": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "r": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "$other": { ".validate": false }
        }
      }
    },
    "beeLog": {
      "$puzzle": {
        ".read": "auth != null",
        "$code": {
          "$k": {
            ".write": "auth != null && newData.exists() && $code === root.child('msgAuth').child(auth.uid).val() && (!data.exists() || (data.child('t').val() === newData.child('t').val() && data.child('e').val() === newData.child('e').val()))",
            ".validate": "$puzzle.matches(/^(es-)?[a-z0]-[a-z0]{6}$/) && $k.matches(/^[0-9]{13}-[0-9]{1,4}$/) && newData.hasChildren(['t', 'e', 's'])",
            "t": { ".validate": "newData.isNumber()" },
            "s": { ".validate": "newData.val() === now" },
            "e": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "w": { ".validate": "newData.isString() && newData.val().length <= 30" },
            "r": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "z": { ".validate": "newData.isNumber() && newData.val() >= -900 && newData.val() <= 900" },
            "k": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "$other": { ".validate": false }
          }
        }
      }
    },

    "pushSubs": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && $code === root.child('msgAuth').child(auth.uid).val()"
      }
    },
    "rooms":          { ".read": "auth != null", ".write": "auth != null", ".indexOn": ["updated"] },
    "selfies":        { ".read": "auth != null", ".write": "auth != null" },
    "skeeballThrows": { ".read": "auth != null", ".write": false },
    "skeeChallenges": { ".read": "auth != null", ".write": "auth != null",
      "games": { "$id": {
        "created": { ".validate": "newData.val() === data.val() || (newData.isNumber() && newData.val() >= now - 120000 && newData.val() <= now + 120000)" },
        "updated": { ".validate": "newData.val() === data.val() || (newData.isNumber() && newData.val() >= now - 120000 && newData.val() <= now + 120000)" },
        "$side": { "started": { "$leg": {
        ".validate": "$leg.matches(/^[0-9]{1,2}$/) && newData.hasChildren(['at', 'k']) && newData.child('k').isString() && newData.child('k').val().length <= 40 && ((data.exists() && newData.child('at').val() === data.child('at').val() && newData.child('k').val() === data.child('k').val()) || (!data.exists() && newData.child('at').val() === now && ($side === 'a' || $side === 'b') && root.child('msgAuth').child(auth.uid).val() === root.child('skeeChallenges').child('games').child($id).child($side).child('code').val()))"
      } } } } } },
    "usernames":      { ".read": "auth != null", ".write": "auth != null" }
  }
}
