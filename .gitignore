# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*~

# Node (no deps committed; here in case tooling is added later)
node_modules/

# Editor / tooling config (not part of the app)
.claude/*
!.claude/skills/

# Local working docs (not for the public repo)

# Reference screenshots of other apps (design reference only, not for the public repo)
mancala/reference/

# RTDB snapshots (backups/rtdb-backup.mjs). Real family data - every player's name, player code
# and full stats - so the snapshots stay LOCAL. The script itself is tracked; its output never is.
backups/*.json

# Visual-suite output (test-visual.mjs). Regenerated on every run; look at it, do not commit it.
.visual-out/

# sim-baseball.mjs's --json report output. Regenerated on every run; look at it, do not commit it.
.sim-out/

# Generated by tools/sync-functions-shared.mjs (copies of js/ modules for the Cloud Functions)
functions/shared/
.boards10-parts/
.boards11-parts/

# tools/lb2-shots.cjs output: real player names, never committed
review-shots/

# THE PRIVATE REPOSITORY (2026-11-25): the server, the tools, the checks' docs and every note live in mpowell95/game-hub-server
# (private). Its setup.sh links them into this folder; these links are never committed here.
/tools
/functions
/backups
/reference
